{
 "crons": [
  {
   "path": "/api/digest",
   "schedule": "0 6 * * *"
  },
  {
   "path": "/api/intel?cron=1",
   "schedule": "0 */6 * * *"
  }
 ],
 "functions": {
  "api/events.js": {
   "maxDuration": 60
  },
  "api/intel.js": {
   "maxDuration": 60
  },
  "api/prep.js": {
   "maxDuration": 60
  }
 },
 "redirects": [
  {
   "source": "/founding50",
   "destination": "/#founding50",
   "permanent": false
  },
  {
   "source": "/free",
   "destination": "/#free",
   "permanent": false
  },
  {
   "source": "/toolkit",
   "destination": "/#free",
   "permanent": false
  },
  {
   "source": "/:path((?!sw\\.js$).*)",
   "has": [
    {
     "type": "host",
     "value": "www.deocoach.org"
    }
   ],
   "destination": "https://www.deocoach.com/:path",
   "permanent": true
  },
  {
   "source": "/:path((?!sw\\.js$).*)",
   "has": [
    {
     "type": "host",
     "value": "deocoach.org"
    }
   ],
   "destination": "https://www.deocoach.com/:path",
   "permanent": true
  },
  {
   "source": "/:path((?!sw\\.js$).*)",
   "has": [
    {
     "type": "host",
     "value": "www.deocoach.app"
    }
   ],
   "destination": "https://www.deocoach.com/:path",
   "permanent": true
  },
  {
   "source": "/:path((?!sw\\.js$).*)",
   "has": [
    {
     "type": "host",
     "value": "deocoach.app"
    }
   ],
   "destination": "https://www.deocoach.com/:path",
   "permanent": true
  }
 ]
}