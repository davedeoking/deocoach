{
 "crons": [
  {
   "path": "/api/digest",
   "schedule": "0 6 * * *"
  },
  {
   "path": "/api/intel?cron=1",
   "schedule": "0 */6 * * *"
  }
 ],
 "functions": {
  "api/events.js": {
   "maxDuration": 60
  },
  "api/intel.js": {
   "maxDuration": 60
  },
  "api/prep.js": {
   "maxDuration": 60
  }
 },
 "redirects": [
  {
   "source": "/:path*",
   "has": [
    {
     "type": "host",
     "value": "(?:www\\.)?deocoach\\.(?:org|app)"
    }
   ],
   "destination": "https://www.deocoach.com/:path*",
   "permanent": true
  }
 ]
}